{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // Tailwind v4 at-rules (@theme/@utility/@custom-variant) and the vendored
    // github-markdown.css aren't parsed well by Biome's CSS linter.
    "includes": ["**", "!**/*.css", "!**/*.svg", "!public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useGenericFontNames": "off"
      },
      "suspicious": {
        "noDuplicateFontNames": "off"
      }
    }
  },
  "overrides": [
    {
      // Generated by the shadcn CLI. Kept as generated so `shadcn add --overwrite` stays a clean diff.
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
