{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // Tailwind v4 at-rules (@theme/@utility/@custom-variant) and the vendored
    // github-markdown.css aren't parsed well by Biome's CSS linter.
    "includes": ["**", "!**/*.css", "!public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useGenericFontNames": "off"
      },
      "suspicious": {
        "noDuplicateFontNames": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
