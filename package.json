{
  "name": "manok-dot-dev",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "env:init": "sh ./env-init.sh local",
    "env:init:staging": "sh ./env-init.sh staging",
    "env:init:prod": "sh ./env-init.sh prod",
    "preview": "next build && next start",
    "db:init": "sh ./docker-init.sh local",
    "db:check": "drizzle-kit check:pg",
    "db:generate": "drizzle-kit generate:pg",
    "db:pull": "drizzle-kit introspect:pg",
    "db:migrate": "tsx ./db/migrate",
    "db:studio": "export DRIZZLE_STUDIO='true' && drizzle-kit studio --port 1337 --verbose",
    "db:seed": "tsx ./db/seed"
  },
  "dependencies": {
