{
  "name": "jspr-vc",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "env:init": "sh ./env-init.sh local",
    "env:init:staging": "sh ./env-init.sh staging",
    "env:init:prod": "sh ./env-init.sh prod",
    "preview": "next build && next start",
    "db:init": "sudo docker compose up -d",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit introspect",
    "db:migrate": "bun ./db/migrate.ts",
    "db:studio": "export DRIZZLE_STUDIO='true' && drizzle-kit studio --port 1337 --verbose",
    "db:seed": "bun ./db/seed.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@hookform/resolvers": "5.4.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.45.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@uploadthing/react": "7.3.3",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "next": "16.3.0-preview.6",
    "next-auth": "4.24.14",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "uploadthing": "7.7.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "lefthook": "2.1.10",
    "pg": "8.22.0",
    "postcss": "8.5.20",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.2",
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "lefthook",
    "msgpackr-extract",
    "sharp"
  ]
}
