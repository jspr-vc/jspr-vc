{
  "name": "jspr-vc",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "env:init": "sh ./env-init.sh local",
    "env:init:staging": "sh ./env-init.sh staging",
    "env:init:prod": "sh ./env-init.sh prod",
    "preview": "next build && next start",
    "db:init": "sudo docker compose up -d",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit introspect",
    "db:migrate": "bun ./db/migrate.ts",
    "db:studio": "export DRIZZLE_STUDIO='true' && drizzle-kit studio --port 1337 --verbose",
    "db:seed": "bun ./db/seed.ts",
    "db:seed:dev": "bun ./db/seed-dev.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shikijs/rehype": "4.6.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-form": "1.33.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lefthook": "2.2.2",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "lefthook",
    "msgpackr-extract",
    "sharp"
  ]
}
